<UserControl x:Class="MediaDownloader.App.Views.SeparatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18">

            <TextBlock Style="{StaticResource PageTitle}" Text="音视分离"/>
            <TextBlock Style="{StaticResource PageSub}"
                       Text="一次产出两个文件：音频 + 无声视频（视频流直接复制，不重编码）"/>

            <!-- 源文件 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="源文件"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}"
                                 Text="{Binding SepInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="选择…"
                                MinWidth="80" Margin="10,0,0,0" Command="{Binding BrowseSepInputCommand}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding SepSourceInfo}" Margin="64,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 音频格式 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="音频格式"/>
                    <ComboBox Grid.Column="1" Width="180" Style="{StaticResource Combo}"
                              SelectedIndex="{Binding SepAudioFormat}">
                        <ComboBoxItem Content="mp3（默认）"/>
                        <ComboBoxItem Content="m4a（音轨原样复制）"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="14,0,0,0"
                               Text="视频侧固定输出 mp4，并去掉音轨"/>
                </Grid>
            </Border>

            <!-- 输出 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="音频输出"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}"
                                 Text="{Binding SepAudioOutput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="打开目录"
                                MinWidth="88" Margin="10,0,0,0" Command="{Binding OpenSepFolderCommand}"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="视频输出"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}"
                                 Text="{Binding SepVideoOutput, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,14,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource Progress}" Height="8" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" Value="{Binding SepPercent, Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" MinWidth="42"
                                   TextAlignment="Right" Margin="10,0,0,0"
                                   Text="{Binding SepPercent, StringFormat={}{0:F0}%}"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnSm}" Content="取消" Margin="12,0,0,0"
                                Command="{Binding CancelSepCommand}"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnPrimary}" Content="开始分离" MinWidth="104"
                                Command="{Binding SepCommand}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="{Binding SepStatus}"
                                   Margin="14,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                    <TextBlock Text="{Binding SepResult}" TextWrapping="Wrap"
                               Foreground="{StaticResource App.Text2}" FontSize="12"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="MediaDownloader.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="设置"/>
            <TextBlock Style="{StaticResource PageSub}" Text="改完即时生效并保存到本地"/>

            <!-- 下载 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="下载"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="下载目录"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}" MaxWidth="560"
                                 HorizontalAlignment="Left" MinWidth="380"
                                 Text="{Binding DownloadDir, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="浏览…"
                                MinWidth="80" Margin="10,0,0,0" Command="{Binding BrowseDirCommand}"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="分片数"/>
                        <TextBox Grid.Column="1" Width="80" Style="{StaticResource Input}" Text="{Binding Segments}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="限速" MinWidth="0"
                                   Margin="20,0,10,0"/>
                        <TextBox Grid.Column="3" Width="80" Style="{StaticResource Input}" Text="{Binding SpeedLimitMB}"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                   Text="单位 MB/s，0 表示不限速；分片数越大越快，但更容易被风控"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="文件已存在"/>
                        <ComboBox Grid.Column="1" Width="220" Style="{StaticResource Combo}"
                                  SelectedIndex="{Binding OnFileExists}">
                            <ComboBoxItem Content="询问我（默认跳过）"/>
                            <ComboBoxItem Content="直接跳过，不再询问"/>
                            <ComboBoxItem Content="直接覆盖重新下载"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="日志"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="记录日志"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableFileLog}" VerticalAlignment="Center"
                                  Content="开启" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="默认关闭。开启后运行日志按天写到 exe 目录的 logs\yyyy-MM-dd.log，用于排查问题"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="64,8,0,0"
                               Text="崩溃兜底日志（%APPDATA%\MediaDownloader\app.log）始终保留，不受此开关影响"/>
                </StackPanel>
            </Border>

            <!-- 外部工具 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="外部工具"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ffmpeg"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}" MaxWidth="560"
                                 HorizontalAlignment="Left" MinWidth="380"
                                 Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="浏览…"
                                MinWidth="80" Margin="10,0,0,0" Command="{Binding BrowseFfmpegCommand}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="64,8,0,0"
                               Text="{Binding Tools.EnvStatus}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="64,4,0,0"
                               Text="同目录还需要 ffprobe.exe，用于读取时长与校验参数"/>
                </StackPanel>
            </Border>

            <!-- 账号 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="账号"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="状态"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Kv}" Text="{Binding LoginStatus}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="扫码登录"
                                MinWidth="88" Command="{Binding LoginCommand}"/>
                        <Button Grid.Column="3" Style="{StaticResource Btn}" Content="退出登录"
                                MinWidth="88" Margin="8,0,0,0" Command="{Binding LogoutCommand}"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SESSDATA"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}" MaxWidth="560"
                                 HorizontalAlignment="Left" MinWidth="380"
                                 Text="{Binding SessDataInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="加密保存"
                                MinWidth="88" Margin="10,0,0,0" Command="{Binding SaveCookieCommand}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="64,8,0,0"
                               Text="从浏览器 Cookie 里复制 SESSDATA 即可，凭证用 DPAPI 加密后存在本机"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

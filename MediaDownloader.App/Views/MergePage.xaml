<UserControl x:Class="MediaDownloader.App.Views.MergePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18">

            <TextBlock Style="{StaticResource PageTitle}" Text="视频合并"/>
            <TextBlock Style="{StaticResource PageSub}"
                       Text="按列表顺序拼接，参数一致时无损，参数不同会被拒绝"/>

            <!-- 文件列表 -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{StaticResource App.Border}" BorderThickness="1" CornerRadius="6"
                            ClipToBounds="True" MinHeight="180">
                        <ListBox Style="{StaticResource FlatList}" ItemsSource="{Binding MergeFiles}"
                                 SelectedItem="{Binding SelectedMergeFile}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Info}" FontSize="11"
                                                   Foreground="{StaticResource App.Text3}"
                                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Column="1" Width="86" Margin="10,0,0,0">
                        <Button Style="{StaticResource Btn}" Content="添加" Command="{Binding AddMergeFilesCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="移除" Margin="0,6,0,0"
                                Command="{Binding RemoveMergeFileCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="上移" Margin="0,6,0,0"
                                Command="{Binding MergeUpCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="下移" Margin="0,6,0,0"
                                Command="{Binding MergeDownCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="重新校验" Height="28" FontSize="12"
                                Margin="0,14,0,0" Command="{Binding RecheckMergeCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 参数校验提示条 -->
            <Border CornerRadius="8" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource App.SurfaceAlt}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource App.Border}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MergeCanCopy}" Value="True">
                                <Setter Property="Background" Value="{StaticResource App.OkSoft}"/>
                                <Setter Property="BorderBrush" Value="#D6EBDD"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding MergeCheckText}" TextWrapping="Wrap" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource App.Text2}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MergeCanCopy}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource App.OkWare}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 输出 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="输出"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}"
                                 Text="{Binding MergeOutput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="打开目录"
                                MinWidth="88" Margin="10,0,0,0" Command="{Binding OpenMergeFolderCommand}"/>
                        <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="开始合并"
                                MinWidth="96" Margin="8,0,0,0" Command="{Binding MergeCommand}"/>
                    </Grid>

                    <Grid Margin="0,14,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource Progress}" Height="8" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" Value="{Binding MergePercent, Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" MinWidth="42"
                                   TextAlignment="Right" Margin="10,0,0,0"
                                   Text="{Binding MergePercent, StringFormat={}{0:F0}%}"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnSm}" Content="取消" Margin="12,0,0,0"
                                Command="{Binding CancelMergeCommand}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Text="{Binding MergeStatus}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                    <TextBlock Text="{Binding MergeResult}" TextWrapping="Wrap"
                               Foreground="{StaticResource App.Text2}" FontSize="12"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

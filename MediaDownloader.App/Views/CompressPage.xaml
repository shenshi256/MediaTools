<UserControl x:Class="MediaDownloader.App.Views.CompressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13"
             AllowDrop="True" Drop="Page_Drop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,18" MaxWidth="980" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="视频压缩"/>
            <TextBlock Style="{StaticResource PageSub}"
                       Text="H.265 重编码，画质优先 · 输入支持 H.264 / H.265 · 默认参数可直接用"/>

            <!-- 输入文件 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="输入文件"/>
                    <Border x:Name="DropZone" BorderBrush="{StaticResource App.BorderStrong}"
                            BorderThickness="1.5" CornerRadius="9" Padding="20"
                            Background="{StaticResource App.SurfaceAlt}" Cursor="Hand"
                            MouseLeftButtonUp="DropZone_Click"
                            DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource App.Text3}"
                                   Text="把 mp4 / mkv 文件拖到这里，或者点击选择（可多选）"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource App.HoverSoft}" CornerRadius="14"
                                        Padding="8,3" Margin="0,2,8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300"
                                                   ToolTip="{Binding Path}"/>
                                        <TextBlock Text="{Binding SizeText, StringFormat=· {0}}" Margin="6,0,0,0"
                                                   Foreground="{StaticResource App.Text3}" VerticalAlignment="Center"/>
                                        <Button Content="✕" Style="{StaticResource BtnGhost}" MinWidth="0" Padding="6,0"
                                                Margin="6,0,0,0" Command="{Binding DataContext.RemoveInputCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 压缩设置 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="压缩设置"/>

                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="模式" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource NavItem}" GroupName="CmpMode" Tag="0"
                                         IsChecked="True" Checked="Mode_Checked"
                                         Content="CRF 质量优先（推荐）"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="CmpMode" Tag="1"
                                         Margin="6,0,0,0" Checked="Mode_Checked" Content="目标体积"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="CmpMode" Tag="2"
                                         Margin="6,0,0,0" Checked="Mode_Checked" Content="自定义参数"/>
                        </StackPanel>
                    </Grid>

                    <!-- CRF 模式面板 -->
                    <StackPanel Visibility="{Binding CrfVisible, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="编码器" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource NavItem}" GroupName="CmpCodec" Tag="0"
                                             IsChecked="True" Checked="Encoder_Checked"
                                             Content="H.265（体积最小，推荐）"/>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="CmpCodec" Tag="1"
                                             Margin="6,0,0,0" Checked="Encoder_Checked" Content="H.264（兼容一切设备）"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="画质档位" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Background="{StaticResource App.Surface}" BorderBrush="{StaticResource App.Border}"
                                        CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                    <RadioButton Style="{StaticResource NavItem}" GroupName="CmpQ" Tag="0" Checked="Quality_Checked">
                                        <StackPanel>
                                            <TextBlock Text="视觉无损 · CRF 22" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="几乎看不出差别，体积较大" Margin="0,0,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Background="{StaticResource App.AccentSoft}" BorderBrush="{StaticResource App.AccentBorder}"
                                        CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                    <RadioButton Style="{StaticResource NavItem}" GroupName="CmpQ" Tag="1" IsChecked="True" Checked="Quality_Checked">
                                        <StackPanel>
                                            <TextBlock Text="推荐 · CRF 24" FontWeight="SemiBold" Foreground="{StaticResource App.Accent}"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="极难察觉，体积与质量平衡"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Background="{StaticResource App.Surface}" BorderBrush="{StaticResource App.Border}"
                                        CornerRadius="8" Padding="12,8">
                                    <RadioButton Style="{StaticResource NavItem}" GroupName="CmpQ" Tag="2" Checked="Quality_Checked">
                                        <StackPanel>
                                            <TextBlock Text="较小 · CRF 26" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="认真看有轻微损失"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="编码速度" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" Width="230" Style="{StaticResource Combo}" SelectedIndex="1"
                                      SelectionChanged="Preset_Changed">
                                <ComboBoxItem Content="fast（快，体积略大）" Tag="fast"/>
                                <ComboBoxItem Content="medium（推荐）" Tag="medium"/>
                                <ComboBoxItem Content="slow（慢 2 倍，再省约 10%）" Tag="slow"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="越慢压得越小，离线压缩不赶时间可用 slow"/>
                        </Grid>
                    </StackPanel>

                    <!-- 目标体积面板 -->
                    <StackPanel Visibility="{Binding SizeVisible, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="目标大小" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource Input}" Width="90"
                                         Text="{Binding TargetSizeMB, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource App.Text2}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="按片长估算码率，自动跑两遍编码（2Pass）逼近目标；音频固定 AAC 96k"/>
                        </Grid>
                    </StackPanel>

                    <!-- 自定义面板 -->
                    <StackPanel Visibility="{Binding AdvVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ffmpeg 参数" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputMono}" Text="{Binding CustomArgs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="给高级用户：原样追加到 ffmpeg 命令，双引号里的空格不会切开；写错了会直接报 ffmpeg 的错"/>
                    </StackPanel>

                    <Separator Margin="0,12" Background="{StaticResource App.BorderSoft}"/>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="音频" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" Width="240" Style="{StaticResource Combo}" SelectedIndex="{Binding AudioIndex}">
                            <ComboBoxItem Content="复制原音轨（无损，最快）"/>
                            <ComboBoxItem Content="重压 AAC 96k（人声/环境音足够）"/>
                            <ComboBoxItem Content="重压 AAC 128k（音乐 MV 用这档）"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="输出" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" Width="260" Style="{StaticResource Combo}" SelectedIndex="{Binding OutputIndex}">
                            <ComboBoxItem Content="与源文件同目录，文件名追加「_c」"/>
                            <ComboBoxItem Content="统一放到下载目录 down\"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="分辨率始终保持原始值：降分辨率是唯一肉眼必查的降级，这里不提供"/>
                </StackPanel>
            </Border>

            <!-- 动作 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnPrimary}" Content="加入压缩队列" MinWidth="130"
                                Command="{Binding AddQueueCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="先试压 30 秒" MinWidth="110" Margin="10,0,0,0"
                                Command="{Binding TestCommand}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Text="试压取片长约 1/4 处的 30 秒，先看效果再压全片，不会占用队列"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="{Binding EstimateText}"/>
                </StackPanel>
            </Border>

            <!-- 队列 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="压缩队列"/>
                    <ListView Style="{StaticResource FlatList}" ItemsSource="{Binding Tasks}" MinHeight="60">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding InputPath}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ArgsSummary}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource App.Text2}"/>

                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Style="{StaticResource Progress}" Minimum="0" Maximum="100"
                                                     Value="{Binding Percent, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="8,0,0,0"
                                                   MinWidth="34" TextAlignment="Right"
                                                   Text="{Binding Percent, StringFormat={}{0:F0}%}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="3" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Text="{Binding SizeText}" TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BtnSm}" Content="打开" MinWidth="52" Margin="0,0,6,0"
                                                Command="{Binding OpenCommand}"/>
                                        <Button Style="{StaticResource BtnSm}" Content="取消 / 移除" MinWidth="80"
                                                Command="{Binding DataContext.QueueRemoveCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="队列串行执行（一个压完再压下一个）；压完的文件放在源文件旁边，确认效果后可手动删源"/>
                </StackPanel>
            </Border>

            <Grid Margin="2,6,2,0">
                <TextBlock Style="{StaticResource Hint}" Text="{Binding EnvStatus}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Hint}" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

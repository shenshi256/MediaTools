<UserControl x:Class="MediaDownloader.App.Views.TrimPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MediaDownloader.App.Controls"
             FontFamily="{StaticResource UiFont}" FontSize="13">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18">

            <!-- 页头 -->
            <TextBlock Style="{StaticResource PageTitle}" Text="视频截取"/>
            <TextBlock Style="{StaticResource PageSub}"
                       Text="时间轴上单击打点分段，切几下就分几段，首尾自动计算"/>

            <!-- 源文件 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="源文件"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}"
                                 Text="{Binding TrimInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="选择…"
                                MinWidth="80" Margin="10,0,0,0" Command="{Binding BrowseTrimInputCommand}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding TrimSourceInfo}"
                               Margin="64,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 时间轴 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Border Background="#F1F3F6" BorderBrush="{StaticResource App.Border}"
                                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <ctrl:TimelineStrip x:Name="Timeline" Height="48" Margin="3"
                                                Duration="{Binding TrimSourceDuration}"
                                                Segments="{Binding Segments}"
                                                SelectedSegment="{Binding SelectedSegment}"/>
                        </Border>

                        <Popup x:Name="ThumbPopup" AllowsTransparency="True" StaysOpen="True"
                               Placement="Relative" PlacementTarget="{Binding ElementName=Timeline}"
                               IsHitTestVisible="False">
                            <Border Background="#F2202124" CornerRadius="6" Padding="5,5,5,4"
                                    BorderBrush="#FF3C4043" BorderThickness="1">
                                <StackPanel>
                                    <Image x:Name="ThumbImage" Width="180" Height="101" Stretch="Uniform"/>
                                    <TextBlock x:Name="ThumbTime" Foreground="#FFF1F3F4" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Text="{Binding SegmentsInfo}"
                               Margin="2,10,0,0"/>

                    <Grid Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="单击空白插入切点 · 单击橙色切点删除 · 右键撤销上一个切点"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnSm}" Content="撤销切点"
                                    Command="{Binding UndoCutCommand}"/>
                            <Button Style="{StaticResource BtnSm}" Content="清除切点" Margin="6,0,0,0"
                                    Command="{Binding ClearCutsCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 段边界 + 模式 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="段起点"/>
                        <TextBox Grid.Column="1" Width="110" Style="{StaticResource InputMono}"
                                 Text="{Binding TrimStart}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="段终点"
                                   MinWidth="0" Margin="16,0,10,0"/>
                        <TextBox Grid.Column="3" Width="110" Style="{StaticResource InputMono}"
                                 Text="{Binding TrimEnd}"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource Hint}"
                                   Text="支持 83.5 / 01:23 / 1:02:03，改这里会移动对应切点"
                                   Margin="16,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="模式"/>
                        <ComboBox Grid.Column="1" Width="150" Style="{StaticResource Combo}"
                                  SelectedIndex="{Binding TrimModeIndex}">
                            <ComboBoxItem Content="快速（无损）"/>
                            <ComboBoxItem Content="精确（重编码）"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}"
                                   Text="{Binding TrimModeHint}" Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 段列表 + 操作 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0" Padding="0" ClipToBounds="True">
                    <ListBox Style="{StaticResource FlatList}" MinHeight="132" MaxHeight="248"
                             ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
                                <Setter Property="Padding" Value="12,7"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding IndexText}"
                                               Foreground="{StaticResource App.Text3}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StartText}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text=" → " FontSize="12"
                                               Foreground="{StaticResource App.Text3}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding EndText}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{Binding LengthText}"
                                               FontSize="11" Foreground="{StaticResource App.Text3}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Column="1" Width="184" Margin="12,0,0,0">
                    <Button Style="{StaticResource BtnPrimary}" Content="开始截取" Height="34"
                            Command="{Binding TrimCommand}"/>
                    <Button Style="{StaticResource Btn}" Content="取消" Margin="0,8,0,0"
                            Command="{Binding CancelTrimCommand}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="2,10,0,0"
                               Text="多段时输出为 名_01.mp4、名_02.mp4…"/>
                </StackPanel>
            </Grid>

            <!-- 输出 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="输出"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputMono}"
                                 Text="{Binding TrimOutput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="打开目录"
                                MinWidth="88" Margin="10,0,0,0" Command="{Binding OpenTrimFolderCommand}"/>
                    </Grid>

                    <Grid Margin="0,14,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource Progress}" Height="8" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" Value="{Binding TrimPercent, Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" MinWidth="42"
                                   TextAlignment="Right" Margin="10,0,0,0"
                                   Text="{Binding TrimPercent, StringFormat={}{0:F0}%}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 结果 -->
            <Border Style="{StaticResource Card}" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                    <TextBlock Text="{Binding TrimResult}" TextWrapping="Wrap"
                               Foreground="{StaticResource App.Text2}" FontSize="12"/>
                </ScrollViewer>
            </Border>

            <TextBlock Style="{StaticResource Hint}" Text="{Binding TrimStatus}" Margin="2,0,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="MediaDownloader.App.Views.TencentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="腾讯视频下载"/>
            <TextBlock Style="{StaticResource PageSub}"
                       Text="粘贴 v.qq.com 链接后回车解析。只下载免费内容——会员视频和 DRM 加密的内容不提供，也不做任何绕过。"/>
        </StackPanel>

        <!-- 输入 -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Style="{StaticResource Input}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ParseCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="解析"
                        MinWidth="90" Margin="10,0,0,0" Command="{Binding ParseCommand}"/>
            </Grid>
        </Border>

        <!-- 视频信息 -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding VideoTitle}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VideoTitle}" Value="">
                                        <Setter Property="Text" Value="（尚未解析）"/>
                                        <Setter Property="Foreground" Value="{StaticResource App.Text3}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="下载所选"
                            MinWidth="100" Margin="12,0,0,0" Command="{Binding DownloadCommand}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="视频信息"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Kv}" Text="{Binding VideoInfo}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="清晰度"
                               MinWidth="0" Margin="16,0,10,0"/>
                    <ComboBox Grid.Column="3" Width="200" Style="{StaticResource Combo}"
                              ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- 会员拦截提示 -->
        <Border Grid.Row="3" Background="{StaticResource App.OkWare}" BorderBrush="#F0DDB8"
                BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,10"
                Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BlockedHint}" TextWrapping="Wrap"
                       Foreground="{StaticResource App.Warn}" FontSize="12"/>
        </Border>

        <!-- 分集 + 任务 -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- 分集列表 -->
            <Border Grid.Row="0" Style="{StaticResource CardFlush}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource App.Border}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectionText}" Margin="0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="灰色行是会员 / DRM 内容，已禁用勾选"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnSm}" Content="全选免费"
                                        Command="{Binding SelectAllCommand}"/>
                                <Button Style="{StaticResource BtnSm}" Content="清空" Margin="6,0,0,0"
                                        Command="{Binding ClearCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Style="{StaticResource FlatList}" ItemsSource="{Binding Episodes}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
                                <Setter Property="Padding" Value="12,6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding NumberText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource App.Text2}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                               ToolTip="{Binding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource App.Text3}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" VerticalAlignment="Center"
                                               Style="{StaticResource Hint}"/>

                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource App.Text3}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource App.Warn}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 下载任务 -->
            <Border Grid.Row="2" Style="{StaticResource CardFlush}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource App.Border}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource CardTitle}" Text="下载任务" Margin="0"/>
                    </Border>

                    <Border Grid.Row="1" Padding="12,7" Margin="0,0,10,0"
                            BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="名称"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="清晰度"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="进度"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="速度"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Text="状态"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Style="{StaticResource FlatList}" ItemsSource="{Binding Tasks}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
                                <Setter Property="Padding" Value="12,8"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                               ToolTip="{Binding OutputPath}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding QualityName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource App.Text2}"/>

                                    <Grid Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                          ToolTip="{Binding SizeText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Style="{StaticResource Progress}" VerticalAlignment="Center"
                                                     Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="8,0,0,0"
                                                   MinWidth="34" TextAlignment="Right"
                                                   Text="{Binding Percent, StringFormat={}{0:F0}%}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="{Binding SpeedText}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Text="{Binding StateText}"/>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BtnSm}" Content="{Binding StartButtonText}"
                                                MinWidth="68" Margin="0,0,6,0" Command="{Binding StartCommand}"/>
                                        <Button Style="{StaticResource BtnSm}" Content="暂停" MinWidth="46" Margin="0,0,6,0"
                                                Command="{Binding PauseCommand}"
                                                Visibility="{Binding PauseVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource BtnSm}" Content="打开" MinWidth="46" Margin="0,0,6,0"
                                                Command="{Binding OpenCommand}"
                                                Visibility="{Binding OpenVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource BtnSm}" Content="删除" MinWidth="46"
                                                Command="{Binding CancelCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Grid Grid.Row="5" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="16,0,0,0"
                       Text="纯直连接口，不需要登录 · 未登录最高 720P"/>
        </Grid>
    </Grid>
</UserControl>

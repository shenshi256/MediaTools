<UserControl x:Class="MediaDownloader.App.Views.YoutubePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="YouTube 下载"/>
            <TextBlock Style="{StaticResource PageSub}"
                       Text="粘贴 YouTube 链接后回车解析。需要本机网络能访问 YouTube（本工具不配置代理）。"/>
        </StackPanel>

        <!-- yt-dlp 缺失提示 -->
        <Border Grid.Row="1" Background="{StaticResource App.OkWare}" BorderBrush="#F0DDB8"
                BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,10"
                Visibility="{Binding ToolMissing, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ToolMissingHint}" TextWrapping="Wrap"
                       Foreground="{StaticResource App.Warn}" FontSize="12"/>
        </Border>

        <!-- 输入 -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Style="{StaticResource Input}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ParseCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="解析"
                        MinWidth="90" Margin="10,0,0,0" Command="{Binding ParseCommand}"/>
            </Grid>
        </Border>

        <!-- Cookie 配置（可选） -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <!-- 折叠开关行 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnSm}" MinWidth="110"
                            Content="Cookie 设置" Command="{Binding ToggleCookiePanelCommand}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Kv}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Text="{Binding CookieStatus}"
                               TextTrimming="CharacterEllipsis"/>
                    <!--<TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center"
                               Text="可选：不配置也能下公开视频"/>-->
                </Grid>

                <!-- 展开的粘贴区 -->
                <StackPanel Visibility="{Binding IsCookiePanelOpen, Converter={StaticResource BoolToVis}}"
                            Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="用浏览器扩展“Get cookies.txt LOCALLY”导出 YouTube 的 Netscape 格式 Cookie，把内容整个粘贴到下面，点保存。"/>
                    <TextBox Style="{StaticResource Input}" Margin="0,8,0,0"
                             MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding CookieText, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnPinkFilled}" Content="图文指导" MinWidth="88"
                                Command="{Binding CookieHelpCommand}"/>
                        <Button Style="{StaticResource BtnSm}" Content="清空 Cookie" MinWidth="88"
                                Margin="8,0,0,0" Command="{Binding ClearCookieCommand}"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="保存" MinWidth="72"
                                Margin="8,0,0,0" Command="{Binding SaveCookieCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 视频信息 + 格式选择 + 下载 -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 视频信息 -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding VideoTitle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VideoTitle}" Value="">
                                            <Setter Property="Text" Value="（尚未解析视频）"/>
                                            <Setter Property="Foreground" Value="{StaticResource App.Text3}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="下载"
                                MinWidth="90" Margin="12,0,0,0" Command="{Binding DownloadCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="视频信息"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Kv}" Text="{Binding VideoInfo}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="格式"
                                   MinWidth="0" Margin="16,0,10,0"/>
                        <ComboBox Grid.Column="3" Width="300" Style="{StaticResource Combo}"
                                  ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- 下载任务 -->
            <Border Grid.Row="1" Style="{StaticResource CardFlush}" ClipToBounds="True" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource App.Border}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource CardTitle}" Text="下载任务" Margin="0"/>
                    </Border>

                    <Border Grid.Row="1" Padding="12,7" Margin="0,0,10,0"
                            BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="名称"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="格式"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="进度"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="速度"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Text="状态"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Style="{StaticResource FlatList}" ItemsSource="{Binding Tasks}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
                                <Setter Property="Padding" Value="12,8"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                               ToolTip="{Binding OutputPath}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding QualityName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource App.Text2}"/>

                                    <Grid Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                          ToolTip="{Binding SizeText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Style="{StaticResource Progress}" VerticalAlignment="Center"
                                                     Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="8,0,0,0"
                                                   MinWidth="34" TextAlignment="Right"
                                                   Text="{Binding Percent, StringFormat={}{0:F0}%}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="{Binding SpeedText}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Text="{Binding StateText}"/>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BtnSm}" Content="{Binding StartButtonText}"
                                                MinWidth="68" Margin="0,0,6,0" Command="{Binding StartCommand}"/>
                                        <Button Style="{StaticResource BtnSm}" Content="暂停" MinWidth="46" Margin="0,0,6,0"
                                                Command="{Binding PauseCommand}"
                                                Visibility="{Binding PauseVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource BtnSm}" Content="打开" MinWidth="46" Margin="0,0,6,0"
                                                Command="{Binding OpenCommand}"
                                                Visibility="{Binding OpenVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource BtnSm}" Content="删除" MinWidth="46"
                                                Command="{Binding CancelCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Grid Grid.Row="5" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="16,0,0,0"
                       Text="由 yt-dlp 下载 · 走系统代理"/>
        </Grid>
    </Grid>
</UserControl>

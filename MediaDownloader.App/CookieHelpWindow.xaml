<Window x:Class="MediaDownloader.App.CookieHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="获取 YouTube Cookie 图文指导" Height="680" Width="640"
        MinWidth="520" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" FontSize="13">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="获取 YouTube Cookie"/>
            <TextBlock Style="{StaticResource PageSub}" TextWrapping="Wrap"
                       Text="用浏览器扩展「Get cookies.txt LOCALLY」导出登录态，粘贴到 YouTube 页的 Cookie 设置里。Cookie 可选：不配也能下公开视频，配了才能下会员 / 年龄限制内容。"/>
        </StackPanel>

        <!-- 步骤 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <!-- 步骤 1 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="① 安装扩展"/>
                        <TextBlock Style="{StaticResource Kv}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="在 Chrome 或 Edge 里安装「Get cookies.txt LOCALLY」扩展（必须是这个，别的扩展 yt-dlp 兼容性差）。"/>
                        <TextBlock Style="{StaticResource Kv}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="扩展商店：" Foreground="{StaticResource App.Text2}"/>
                            <Hyperlink NavigateUri="https://chromewebstore.google.com/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc"
                                       RequestNavigate="OnOpenLink">
                                https://chromewebstore.google.com/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc
                            </Hyperlink>
                        </TextBlock>
                        <Image Source="pack://application:,,,/Assets/cookie-install.png"
                               Margin="0,10,0,0" Stretch="Uniform" MaxHeight="260"/>
                    </StackPanel>
                </Border>

                <!-- 步骤 2 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="② 登录 YouTube 并导出"/>
                        <TextBlock Style="{StaticResource Kv}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="用同一浏览器访问 youtube.com 并登录账号，然后点扩展图标，在弹出面板里点 Export（导出格式保持 Netscape）。"/>
                        <Image Source="pack://application:,,,/Assets/cookie-export.png"
                               Margin="0,10,0,0" Stretch="Uniform" MaxHeight="260"/>
                    </StackPanel>
                </Border>

                <!-- 步骤 3 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="③ 粘贴并保存"/>
                        <TextBlock Style="{StaticResource Kv}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="浏览器会下载一个 www.youtube.com_cookies.txt 文件。打开它全选内容，粘贴到 YouTube 页「Cookie 设置」展开后的文本框里，点「保存」即可。"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Cookie 以明文存在程序目录的 youtube-cookies.txt，不含密码；会过期，失效后重新按上面步骤导一次即可。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="知道了" Width="90" Height="30" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

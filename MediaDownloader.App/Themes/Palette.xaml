<!--
  设计令牌：与 docs/ui-draft.html 中确认的草稿一一对应。
  只放颜色、字体这类"原子"，控件样式统一在 Controls.xaml 里组装。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 字体 -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 中性色 -->
    <SolidColorBrush x:Key="App.Bg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="App.Border" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="App.BorderSoft" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="App.BorderStrong" Color="#D6D6D6"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="App.Text" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="App.Text2" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="App.Text3" Color="#8A8A8A"/>

    <!-- 主色（沿用草稿里的蓝） -->
    <SolidColorBrush x:Key="App.Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="App.AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="App.AccentPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="App.AccentSoft" Color="#EFF4FF"/>
    <SolidColorBrush x:Key="App.AccentBorder" Color="#9FBCF7"/>

    <!-- 语义色 -->
    <SolidColorBrush x:Key="App.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="App.Ok" Color="#16A34A"/>
    <SolidColorBrush x:Key="App.OkSoft" Color="#E8F5EC"/>
    <SolidColorBrush x:Key="App.OkWare" Color="#12703A"/>
    <SolidColorBrush x:Key="App.Warn" Color="#F59E0B"/>

    <!-- 粉色（antd pinkPreset #EB2F96 派生，用于「filled + pink」按钮） -->
    <SolidColorBrush x:Key="App.Pink" Color="#EB2F96"/>
    <SolidColorBrush x:Key="App.PinkBg" Color="#FDEEF4"/>
    <SolidColorBrush x:Key="App.PinkBgHover" Color="#FCD4E4"/>
    <SolidColorBrush x:Key="App.PinkBgActive" Color="#FA9EC2"/>

    <!-- 交互态 -->
    <SolidColorBrush x:Key="App.Hover" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="App.HoverSoft" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="App.Track" Color="#E9E9E9"/>

</ResourceDictionary>

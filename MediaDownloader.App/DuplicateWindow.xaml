<Window x:Class="MediaDownloader.App.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件已存在" Height="340" Width="500" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1">
            <ListBox x:Name="FileList" ItemsSource="{Binding Files}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="2" Text="默认跳过：回车或点「跳过」只下载其余分 P；「全部下载」会覆盖同名文件。" Foreground="#666"
                   Margin="0,10,0,6" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="全部下载" Width="90" Height="28" Click="OnDownloadAll"/>
            <Button Content="跳过" Width="70" Height="28" Margin="8,0" IsDefault="True" Click="OnSkip"/>
            <Button Content="取消" Width="70" Height="28" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
